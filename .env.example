# ==============================================================================
# Multimodal EHR CDSS - Environment Configuration Template
# Copy this file to .env before running `docker compose up --build -d`
# ==============================================================================

# --- Service Ports ---
FRONTEND_PORT=3000
API_PORT=8000
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000

# --- Backend API & CORS Configuration ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000

# --- Vector Database (Qdrant) Configuration ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

